{
  "name": "QA Automation Portfolio",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installMaven": "true"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y chromium chromium-driver && echo 'export CHROMIUM_BINARY=/usr/bin/chromium' >> ~/.bashrc",
  "remoteEnv": {
    "CODESPACES": "true",
    "CHROMIUM_BINARY": "/usr/bin/chromium"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "cucumberopen.cucumber-official"
      ]
    }
  },
  "forwardPorts": [4444],
  "remoteUser": "vscode"
}